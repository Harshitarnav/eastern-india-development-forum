# Supabase — https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only. Never commit. Never prefix with NEXT_PUBLIC_.
# Used for CMS writes, form inbox, and media uploads (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://eidf.org.in

# Signup alerts for /join — one email to each address
NOTIFY_EMAIL=sanjeeveecd@gmail.com,harshitarnav@gmail.com
# Resend — https://resend.com → API Keys. Verify a sending domain.
# onboarding@resend.dev only delivers to the inbox on the Resend account.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=EIDF <notifications@eidf.org.in>

# Admin authentication (required in production)
# JWT_SECRET must be at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@eidf.org.in
ADMIN_PASSWORD=EIDF@Admin2026!
ADMIN_NAME=EIDF Administrator
# Optional bcrypt hash instead of plain ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=$2a$12$...

# --- CMS setup ---
# 1. Run supabase/schema.sql in the Supabase SQL editor (tables + RLS).
# 2. Create Storage bucket "eidf-media" (public read) for admin media uploads.
# 3. Seed / sync: npm run seed:cms   OR   Admin → Website CMS → Seed / Reset
#    To push existing local CMS to the live database: npm run sync:cms
# 4. Same Supabase project must be used in local .env.local AND Vercel env vars
#    so admin edits on one environment appear on the live site.
# 5. Without Supabase env vars, the site falls back to content/site.ts + data/cms/store.json
