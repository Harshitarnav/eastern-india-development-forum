# Supabase — https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Server-only. Never commit. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# Optional — email alerts when forms are submitted (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_EMAIL=hello@eidf.org.in

# Admin authentication (required in production)
# JWT_SECRET must be at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ADMIN_EMAIL=admin@eidf.org.in
ADMIN_PASSWORD=EIDF@Admin2026!
ADMIN_NAME=EIDF Administrator
# Optional bcrypt hash instead of plain ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=$2a$12$...
