{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "eidf-landing",
  "main": "worker.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "eidf.info/*", "zone_name": "eidf.info" },
    { "pattern": "www.eidf.info/*", "zone_name": "eidf.info" }
  ]
}
